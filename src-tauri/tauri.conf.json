{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aria IDE",
  "version": "0.1.0",
  "identifier": "com.elevatefoundry.aria-ide",
  "build": {
    "beforeDevCommand": "npm run aria:server",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:3200",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Aria IDE",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
